<?php
/**
 * Modern order items section: compact item rows, totals and the invitation block.
 */

declare(strict_types=1);

// phpcs:disable Magento2.Templates.ThisInTemplate

use Magento\Framework\Escaper;
use Magento\Sales\Block\Order\Email\Items;
use PixelPerfect\SalesEmail\ViewModel\Invitation;

/** @var Items $block */
/** @var Escaper $escaper */

$order = $block->getOrder();
?>
<?php if ($order): ?>
    <?php
    /** @var Invitation $invitation */
    $invitation = $block->getData('invitation_view_model');
    $invitationHtml = $invitation->getHtml('order', (int)$order->getStoreId());
    ?>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td class="pp-items-wrap">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <?php foreach ($order->getAllItems() as $item): ?>
                        <?php if (!$item->getParentItem()): ?>
                            <?= /* @noEscape */ $block->getItemHtml($item) ?>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </table>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="pp-totals-wrap">
                    <?= /* @noEscape */ $block->getChildHtml('order_totals') ?>
                </table>
            </td>
        </tr>
        <?php if ($invitationHtml !== ''): ?>
            <tr>
                <td class="pp-invitation-wrap">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr><td class="pp-invitation"><?= /* @noEscape */ $invitationHtml ?></td></tr>
                    </table>
                </td>
            </tr>
        <?php endif; ?>
    </table>
<?php endif; ?>
