<?php
/**
 * Bundle order item: parent row, selections listed under it in the muted style.
 */

declare(strict_types=1);

// phpcs:disable Magento2.Templates.ThisInTemplate

use Magento\Framework\Escaper;
use Magento\Bundle\Block\Sales\Order\Items\Renderer;
use PixelPerfect\SalesEmail\ViewModel\EmailGiftMessage;
use PixelPerfect\SalesEmail\ViewModel\EmailItem;

/** @var Renderer $block */
/** @var Escaper $escaper */

$item = $block->getItem();
$order = $item->getOrder();
/** @var EmailItem $viewModel */
$viewModel = $block->getData('view_model');
/** @var EmailGiftMessage $giftViewModel */
$giftViewModel = $block->getData('gift_view_model');
$imageUrl = $viewModel->getImageUrl($item, (int)$order->getStoreId());
$giftHtml = $giftViewModel->getItemHtml($item);
$options = $block->getItemOptions();
$open = ' pp-item-open';
?>
<tr>
    <td class="pp-item-image<?= $open ?>" width="64" valign="middle">
        <?php if ($imageUrl !== null): ?>
            <img class="pp-item-img" src="<?= $escaper->escapeUrl($imageUrl) ?>" width="64" height="64"
                 alt="<?= $escaper->escapeHtmlAttr($item->getName()) ?>" border="0" />
        <?php else: ?>
            <table role="presentation" width="64" height="64" cellpadding="0" cellspacing="0" border="0">
                <tr><td class="pp-item-placeholder" width="64" height="64" bgcolor="#f6f6f4">&nbsp;</td></tr>
            </table>
        <?php endif; ?>
    </td>
    <td class="pp-item-info<?= $open ?>" valign="middle">
        <p class="pp-item-name"><?= $escaper->escapeHtml($item->getName()) ?></p>
        <p class="pp-item-meta"><?= $escaper->escapeHtml(__('Qty: %1', $viewModel->formatQty((float)$item->getQtyOrdered(), (int)$order->getStoreId()))) ?></p>
    </td>
    <td class="pp-item-price<?= $open ?>" valign="middle" align="right">
        <?= /* @noEscape */ $block->getItemPrice($item) ?>
    </td>
</tr>
<?php $previousOption = null; ?>
<?php foreach ($item->getChildrenItems() as $child): ?>
    <?php $attributes = $block->getSelectionAttributes($child); ?>
    <?php if ($previousOption !== $attributes['option_id']): ?>
        <tr>
            <td></td>
            <td colspan="2" class="pp-item-option-label"><?= $escaper->escapeHtml($attributes['option_label']) ?></td>
        </tr>
        <?php $previousOption = $attributes['option_id']; ?>
    <?php endif; ?>
    <tr>
        <td></td>
        <td colspan="2" class="pp-item-child"><?= /* @noEscape */ $block->getValueHtml($child) ?></td>
    </tr>
<?php endforeach; ?>
<tr>
    <td colspan="3" class="pp-item-extra">
        <?php if ($options): ?>
            <p class="pp-item-options">
                <?php foreach ($options as $option): ?>
                    <?= $escaper->escapeHtml($option['label']) ?>:
                    <?= /* @noEscape */ $escaper->escapeHtml(nl2br((string)$option['value']), ['br', 'a']) ?><br />
                <?php endforeach; ?>
            </p>
        <?php endif; ?>
        <?= /* @noEscape */ $giftHtml ?>
    </td>
</tr>
