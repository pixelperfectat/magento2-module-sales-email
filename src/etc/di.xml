<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="PixelPerfect\SalesEmail\Api\ConfigInterface" type="PixelPerfect\SalesEmail\Service\Config"/>
    <preference for="PixelPerfect\SalesEmail\Api\Service\EmailHtmlSanitizerInterface"
                type="PixelPerfect\SalesEmail\Service\EmailHtmlSanitizer"/>
    <preference for="PixelPerfect\SalesEmail\Api\Data\SanitizedHtmlInterface"
                type="PixelPerfect\SalesEmail\Model\Data\SanitizedHtml"/>
    <preference for="PixelPerfect\SalesEmail\Api\Data\TrackingInterface"
                type="PixelPerfect\SalesEmail\Model\Data\Tracking"/>
    <preference for="PixelPerfect\SalesEmail\Api\Service\StoreEmulatorInterface"
                type="PixelPerfect\SalesEmail\Service\StoreEmulator"/>
    <type name="Magento\Sales\Model\Order\Email\Container\OrderIdentity">
        <plugin name="pp_sales_email_identity_template"
                type="PixelPerfect\SalesEmail\Plugin\Sales\Email\IdentityTemplatePlugin"/>
    </type>
    <type name="Magento\Sales\Model\Order\Email\Container\ShipmentIdentity">
        <plugin name="pp_sales_email_identity_template"
                type="PixelPerfect\SalesEmail\Plugin\Sales\Email\IdentityTemplatePlugin"/>
    </type>
</config>
